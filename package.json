{
  "name": "fleetlever-app",
  "version": "0.12.1",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:elliniko": "node scripts/dev-edition.mjs elliniko 3000",
    "dev:console": "node scripts/dev-edition.mjs console 3001",
    "dev:site": "node scripts/dev-edition.mjs site 3002",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "start:next": "next start",
    "railway:predeploy": "node scripts/railway-predeploy.mjs",
    "railway:start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint",
    "design:audit": "node scripts/design-audit.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "qa:all": "npm run lint && npm run build && npm run design:audit && npm run e2e:smoke",
    "db:migrate": "node scripts/migrate.mjs",
    "db:bootstrap-production-tenant": "node scripts/bootstrap-production-tenant.mjs",
    "db:upsert-test-account": "node scripts/upsert-test-account.mjs",
    "db:create-app-role": "node scripts/create-db-app-role.mjs",
    "db:seed": "SEED_DEMO=true node scripts/migrate.mjs",
    "db:reset-demo": "node scripts/reset-demo.mjs",
    "db:health": "node scripts/db-health.mjs",
    "test:edition-config": "node scripts/verify-edition-config.mjs",
    "test:console-edition": "node scripts/verify-console-edition.mjs",
    "test:console-ui": "node scripts/verify-console-ui.mjs",
    "test:edition-routes": "node scripts/verify-edition-routes.mjs",
    "test:commercial-site": "node scripts/verify-commercial-site.mjs",
    "test:commercial-ui": "node scripts/verify-commercial-ui.mjs",
    "lisa:bridge": "node scripts/lisa-bridge.mjs",
    "test:lisa": "node --test scripts/test-lisa-bridge.mjs scripts/test-lisa-relay.mjs && node scripts/verify-lisa-contract.mjs",
    "test:lisa:db": "node scripts/verify-lisa-relay-db.mjs",
    "test:lisa:live": "node scripts/verify-lisa-relay-live.mjs",
    "test:auth": "node --test scripts/test-account-auth.mjs",
    "test:account-ui": "node scripts/verify-account-lisa-ui.mjs",
    "test:customization": "node scripts/verify-customization-contract.mjs && node --test scripts/test-console-snapshot.mjs",
    "test:customization-ui": "node scripts/verify-customization-ui.mjs",
    "test:security": "node --test scripts/test-request-origin.mjs scripts/test-upload-policy.mjs scripts/test-db-connection-security.mjs scripts/test-server-action-auth.mjs && node scripts/verify-security-contract.mjs",
    "test:db-security": "node scripts/verify-runtime-db-security.mjs",
    "test:production-boundaries": "node scripts/verify-production-boundaries.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
