{
  "name": "fleetlever-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "start:next": "next start",
    "railway:predeploy": "npm run db:migrate",
    "railway:start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint",
    "design:audit": "node scripts/design-audit.mjs",
    "concept:smoke": "node scripts/concept-smoke.mjs",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "real:smoke": "node scripts/real-app-smoke.mjs",
    "release:smoke": "node scripts/release-control-smoke.mjs",
    "qa:all": "npm run lint && npm run build && npm run design:audit && npm run e2e:smoke && npm run real:smoke && npm run release:smoke",
    "db:migrate": "node scripts/migrate.mjs",
    "db:bootstrap-production-tenant": "node scripts/bootstrap-production-tenant.mjs",
    "db:create-app-role": "node scripts/create-db-app-role.mjs",
    "db:seed": "SEED_DEMO=true node scripts/migrate.mjs",
    "db:reset-demo": "node scripts/reset-demo.mjs",
    "db:health": "node scripts/db-health.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
