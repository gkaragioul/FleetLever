# FleetLever app runtime
# console = customer application, site = marketing site
FLEETLEVER_EDITION=console
FLEETLEVER_ROOT_EXPERIENCE=app
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com

# Super admin login.
# Store the password as a scrypt hash, never as plaintext.
FLEETLEVER_SUPER_ADMIN_USERNAME=
FLEETLEVER_SUPER_ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# Required whenever NODE_ENV=production. Generate it, e.g.: openssl rand -base64 48
FLEETLEVER_SESSION_SECRET=generate-a-random-secret-with-at-least-32-characters

# Client address for rate limits. Count the proxies you operate in front of the app (1 = the
# platform edge only). Alternatively name a header the platform overwrites on every request,
# e.g. x-vercel-forwarded-for; it then takes precedence over X-Forwarded-For.
FLEETLEVER_TRUSTED_PROXY_HOPS=1
FLEETLEVER_CLIENT_IP_HEADER=

# Public demo workspaces kept on disk at once (oldest removed first, 2 MB each at most).
FLEETLEVER_DEMO_SESSION_MAX=100

# Required in production until full auth/onboarding is enabled.
# These must point to a real customer organization/profile, not demo seed IDs.
FLEETLEVER_DEFAULT_ORGANIZATION_ID=
FLEETLEVER_DEFAULT_PROFILE_ID=

# Used once when creating the first real Railway tenant.
FLEETLEVER_BOOTSTRAP_ORGANIZATION_NAME=FleetLever Developer
FLEETLEVER_BOOTSTRAP_PROFILE_EMAIL=
FLEETLEVER_BOOTSTRAP_PROFILE_NAME=FleetLever Developer
FLEETLEVER_PURGE_DEMO_TENANT=true

# Development/demo-only tenant IDs.
FLEETLEVER_DEMO_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
FLEETLEVER_DEMO_PROFILE_ID=00000000-0000-4000-8000-000000000101

# Railway Postgres
# Runtime must use the restricted app role over Railway private networking.
# Migrations use the separate private administrator URL only during predeploy.
# DATABASE_URL=${{Postgres.APP_DATABASE_PRIVATE_URL}}
# MIGRATION_DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway
MIGRATION_DATABASE_URL=postgresql://admin:password@host:5432/railway
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10

# Optional Railway app-role rotation
APP_DATABASE_PASSWORD=

# Railway Bucket / S3-compatible object storage
# In Railway, connect a Bucket service and reference its variables here.
# Common Railway bucket variables are AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION/AWS_DEFAULT_REGION, AWS_ENDPOINT_URL, and AWS_S3_BUCKET.
FLEETLEVER_BUCKET_NAME="${{Bucket.AWS_S3_BUCKET}}"
AWS_ACCESS_KEY_ID="${{Bucket.AWS_ACCESS_KEY_ID}}"
AWS_SECRET_ACCESS_KEY="${{Bucket.AWS_SECRET_ACCESS_KEY}}"
AWS_REGION="${{Bucket.AWS_REGION}}"
AWS_ENDPOINT_URL="${{Bucket.AWS_ENDPOINT_URL}}"
S3_FORCE_PATH_STYLE=false
# Lisa local Codex companion (development/testing only)
# Lisa forwards signed-in users' questions to a Codex CLI on a workstation. Treat every
# question as untrusted input: keep this off unless that workstation is isolated and holds
# nothing you would not show a customer. All Lisa paths also need this master switch.
FLEETLEVER_LISA_CODEX_ENABLED=false
FLEETLEVER_LISA_ENABLED=false
FLEETLEVER_LISA_LOCAL_BRIDGE_ENABLED=false
FLEETLEVER_LISA_BRIDGE_URL=http://127.0.0.1:3210
FLEETLEVER_LISA_BRIDGE_SECRET=replace-with-at-least-32-random-characters
FLEETLEVER_LISA_BRIDGE_HOST=127.0.0.1
FLEETLEVER_LISA_BRIDGE_PORT=3210
FLEETLEVER_LISA_TIMEOUT_MS=90000

# Hosted app: enable the outbound relay and set one high-entropy shared secret.
# The companion ID identifies the always-on workstation in Lisa's health status.
FLEETLEVER_LISA_RELAY_ENABLED=false
FLEETLEVER_LISA_RELAY_SECRET=replace-with-at-least-32-random-characters
FLEETLEVER_LISA_RELAY_COMPANION_ID=primary

# Always-on workstation only: the public HTTPS origin of the hosted console.
FLEETLEVER_LISA_RELAY_URL=https://app.example.com
# Optional Windows override. The bridge also discovers the Codex desktop executable automatically.
CODEX_BIN=

# Customer account access and transactional email
FLEETLEVER_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_FLEETLEVER_APP_URL=http://127.0.0.1:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
FLEETLEVER_EMAIL_FROM=FleetLever <accounts@example.com>
